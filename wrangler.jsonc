{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tailssh",
  "main": "src/index.js",
  "compatibility_date": "2026-02-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /p/* (relay proxy) and /agent-ws* (agent WebSocket) need the Worker;
    // assets stay on the fast path. Patterns are glob-style, so the exact
    // path needs a trailing * to match.
    "run_worker_first": ["/p/*", "/agent-ws*"]
  },
  // Relay agent: runs on any always-on tailnet device (agent/agent.mjs) and
  // dials targets via that machine's existing tailscaled — no funnel needed.
  "durable_objects": {
    "bindings": [
      { "name": "RELAY", "class_name": "ProxyRelay" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProxyRelay"] }
  ],
  // PROXY_KEY (client auth for /p/*) and RELAY_KEY (agent auth for /agent-ws)
  // are secrets:
  //   npx wrangler secret put PROXY_KEY
  //   npx wrangler secret put RELAY_KEY
  // (for local dev, .dev.vars holds non-secret placeholders).
  //
  // No Tailscale credentials server-side: the browser WASM node still
  // authenticates interactively and the device list comes from its own netmap.
}
